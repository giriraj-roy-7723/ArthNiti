# AI_BACKEND/.env.example

# Example environment variables for the AI Backend application

# Set the environment (development, testing, production)
ENVIRONMENT=development

# Database configuration
DATABASE_URL=postgresql://user:password@localhost:5432/mydatabase

# Secret key for authentication
SECRET_KEY=your_secret_key_here

# Logging configuration
LOG_LEVEL=info

# Other service configurations
SERVICE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0

# Add any additional environment variables needed for your application here.